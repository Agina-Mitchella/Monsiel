# Nyota & Monsiel Prototype Environment Configuration

# Server Port
PORT=3001

# AI Provider Configuration (Optional)
# If provided, Nyota uses Gemini via server-side function calling.
# If omitted, Nyota runs seamlessly on the local companion engine with 100% feature fidelity.
GEMINI_API_KEY=

# Real Monsiel Backend Integration (Optional)
# When Monsiel's actual repository/backend is mounted, set these credentials to switch from
# DemoMonsielAdapter to RealMonsielAdapter.
MONSIEL_API_URL=
MONSIEL_SERVICE_TOKEN=
